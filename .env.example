# =============================================================================
# ChatLatency
#
# There are 50+ variables in this file. You need EIGHT of them to run it, and
# the rest exist so every lever can be flipped in an A/B without touching code.
# Read the short list first; treat everything below the divider as an appendix
# you consult when you want to change one specific behaviour.
#
#   THE EIGHT
#     LLM_PROVIDER          which provider (start with `mock` - no key needed)
#     OPENAI_API_KEY        ...or AZURE_AI_ENDPOINT + AZURE_AI_API_KEY
#     MINI_MODEL            the model that writes the answers
#     AGENTIC               agent loop vs. fixed pipeline - the big comparison
#     MAX_TOOL_HOPS         the step budget (read the note where it is defined)
#     CLASSIFY_INTENT       the 828 ms on the critical path that finding 02 is about
#     CACHE_L1_ENABLED      the cheapest latency win there is
#     ENABLED_TOOLS         which tools the model can see
#
#   To run with no credentials at all:
#     LLM_PROVIDER=mock  RETRIEVER=stub
#   That path is what finding 01 uses to prove the instrument is accurate to
#   1 ms before any conclusion is drawn from it.
# =============================================================================

# ---------- model provider ----------
# foundry | azure | openai | mock
#   foundry -> Azure AI Foundry (services.ai.azure.com), v1 API - the target stack
#   azure   -> classic Azure OpenAI (<resource>.openai.azure.com + api-version)
#   openai  -> OpenAI directly
#   mock    -> simulates TTFT / token rate: measures the harness's own overhead
LLM_PROVIDER=foundry

# Accepts either the resource host OR the project URL the Azure portal shows:
#   https://<resource>.services.ai.azure.com
#   https://<resource>.services.ai.azure.com/api/projects/<project>
# The /api/projects/... path belongs to the projects SDK; for inference the
# harness normalises everything to <host>/openai/v1/.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=

OPENAI_API_KEY=

# Per-provider tier overrides. The tier vars below hold Azure deployment names;
# these let OpenAI model names sit alongside them, so LLM_PROVIDER is the only
# line that changes when switching providers. Empty => fall back to the tier var.
OPENAI_NANO_MODEL=
OPENAI_MINI_MODEL=
OPENAI_FRONTIER_MODEL=
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# The tiers are DEPLOYMENT NAMES (not model names). List yours with:
#   az cognitiveservices account deployment list -n <resource> -g <rg> -o table
NANO_MODEL=gpt-5.6-terra
MINI_MODEL=gpt-5.6-terra
FRONTIER_MODEL=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-small
MAX_OUTPUT_TOKENS=400

# gpt-5.x accepts reasoning_effort and the valid value varies per model:
# gpt-5.6-terra accepts only "none"; gpt-5.2 accepts "minimal". Leave it empty
# to not send the parameter at all (gpt-4.x models reject it).
REASONING_EFFORT=none

# ---------- price ----------
# It is NOT hardcoded here. It comes from data/model_prices.csv, resolved PER MODEL:
#   uv run python scripts/fetch_prices.py            # refresh the CSV
#   uv run python scripts/fetch_prices.py --check    # only check whether it moved
# Checked on 2026-08-27: gpt-5.6-terra = $2.00 in / $0.20 cached / $12.00 out per
# 1M (azure/gpt-5.6-terra). Cached input is now published rather than derived from
# "10% of input". A pinned region (azure/us/, azure/eu/) costs ~10% more and has
# its own row - use PRICE_CATALOG_PREFIX if that is your case.
PRICE_CURRENCY=USD

# Override: fill in BOTH in and out to force one price for EVERY model (the
# enterprise-contract case, where list price does not apply). Empty => catalogue.
#PRICE_IN_PER_MTOK=2.00
#PRICE_CACHED_IN_PER_MTOK=0.20
#PRICE_OUT_PER_MTOK=12.00

# A deployment with a custom name -> a catalogue model. Without this, a
# deployment that does not match falls back and shows as a placeholder in the UI.
#PRICE_MODEL_ALIASES=my-prod-deploy=gpt-5.6-terra
#PRICE_CATALOG_PREFIX=azure/us/

# provider=mock: the budget targets, used to validate the instrumentation
MOCK_TTFT_MS=1050
MOCK_TOKENS_PER_S=170
MOCK_OUTPUT_TOKENS=250

# ---------- agent topology ----------
# true  -> agent loop: the model picks the tools (>= 2 hops when it uses one)
# false -> fixed pipeline: retrieval always, 1 hop
# Comparing the two is the most useful measurement this engine makes:
#   uv run python -m bench.load --scenario ab-agentic
AGENTIC=true

# ---------- tools ----------
# metric_lookup   in-memory dict                              ~0.03 ms
# latency_budget  pure arithmetic                             ~0.01 ms
# kb_search       ChromaDB + in-process ONNX embedding        ~23-45 ms
# web_search      Browserbase Search                          ~1 s
# web_fetch       Browserbase Fetch                           ~1-3 s
# web_browse      Stagehand (a real browser) - opt-in         ~10-30 s
# simulate_tool   waits exactly as long as you ask             you choose
# summarize       runs the nano model INSIDE the tool          ~1 s + tokens
#
# The last two need no credential. simulate_tool makes every hop and
# parallelism lesson reproducible on a fresh clone (it is a declared simulator
# and is flagged `simulated: true` in the trace); summarize reproduces finding
# 16 - a tool with a model inside spends tokens the turn's usage never sees.
ENABLED_TOOLS=kb_search,metric_lookup,latency_budget,simulate_tool,summarize,web_search,web_fetch

# Ceiling on model round trips per turn. Read it as a BUDGET, not a safety net:
# reaching the internet spends two hops (web_search returns titles and URLs
# only, so web_fetch has to follow) plus one to answer. At 3, a single wasted
# first hop makes the internet unreachable and the model answers "you would
# need to check the website" - which reads as a broken tool. The trace now
# reports `hops_exhausted` when the ceiling, not the model, ended the loop.
MAX_TOOL_HOPS=3

# ---------- what the trace carries ----------
# The raw exchange: the messages sent on each hop, what came back (text or
# tool_calls), and each tool's real output. This is the half of the trace you
# debug with - the numbers say how long, this says what happened. Shown in the
# UI under "the exchange". Off shrinks the trace to timings only.
TRACE_PAYLOADS=true
# Per-field cap. A 6,000 character page would otherwise BE the trace; the true
# size is still reported as result_chars, and truncation announces itself.
TRACE_PAYLOAD_CHARS=4000

# ChromaDB: empty => in-memory index, rebuilt at startup (~500 ms for 21 docs)
CHROMA_COLLECTION=kb_local
CHROMA_PERSIST_DIR=

# ---------- the internet: Browserbase ----------
# Three primitives for the same job, with an order of magnitude between them:
#   web_search  POST /v1/search  ~1 s     titles + URLs, NO snippet
#   web_fetch   POST /v1/fetch   ~1-3 s   page as markdown, no JavaScript
#   web_browse  Stagehand        ~10-30s  real browser, JS runs, act/extract
#
# Search does NOT return a summary - only title and URL. An agent that only
# searches has nothing to read: it needs a web_fetch afterwards, which costs one
# more model hop just to decide which URL to open.
BROWSERBASE_API_KEY=
WEB_SEARCH_BACKEND=browserbase
WEB_SEARCH_TIMEOUT_S=20

# Fetch can return up to 5 MB. Without a cap, one turn swallows the whole page as
# input tokens - it is a cost and latency lever, so it stays explicit.
WEB_FETCH_MAX_CHARS=6000
WEB_FETCH_FORMAT=markdown

# ---------- web_browse: the only tool that opens a browser session ----------
# Off by default. 12.3 s measured per call (41% of it just opening the session),
# it creates a session visible in the Browserbase dashboard, and it runs a model
# INSIDE the tool whose cost never passes through the provider usage (finding 16).
# It also requires: uv sync --extra browse
ENABLE_WEB_BROWSE=false
STAGEHAND_MODEL=openai/gpt-4.1

# Without BROWSERBASE_API_KEY the backend falls back to duckduckgo (which works
# with no key, so the repo runs out of the box) and /healthz marks degraded=true.
# Alternatives:
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---------- latency levers (each one is an experiment) ----------
DETECT_LOCALE=false
CLASSIFY_INTENT=true
SPECULATIVE_RETRIEVAL=true
CACHE_L1_ENABLED=true

# The canonical tier: keyed on (entity, attribute) rather than on the wording, so
# it catches a paraphrase with an exact lookup and no embedding. It is finding
# 06's recommendation, implemented - which is why it ships ON while L2 does not.
# Its safety is not a threshold, it is that it DECLINES: a question whose entity
# and attribute it cannot name produces no key, and no key is a miss. Audit what
# it can name in _METRIC_ALIASES and _ATTRIBUTE_CUES (app/retrieval.py), and gate
# changes to them with:
#   uv run pytest tests/test_canonical_cache.py
#   PYTHONPATH=. uv run python scripts/calibrate_canonical.py   # exits != 0 on a collision
CACHE_CANONICAL_ENABLED=true

# The semantic L2 is OFF by default - a decision based on measurement, not taste.
# `scripts/calibrate_l2.py` shows there is no safe threshold: pairs with OPPOSITE
# answers ("how to enable" vs "how to disable") score around 0.79 similarity,
# above legitimate paraphrases that drop to 0.48. Turned on, the cache returns the
# wrong answer with confidence. Enable it only to MEASURE (the cache-curve
# scenario turns it on by itself); for the paraphrase hits it was wanted for, use
# CACHE_CANONICAL_ENABLED above. See finding 06 in docs/FINDINGS.md.
CACHE_L2_ENABLED=false
CACHE_L2_THRESHOLD=0.95
CACHE_TTL_S=3600
CACHED_REPLAY_TOKENS_PER_S=0

# ---------- retrieval ----------
# local | stub | search
RETRIEVER=local
RETRIEVAL_STUB_MS=150
RETRIEVAL_TOP_K=3
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=kb-content

# ---------- external state ----------
# empty => an in-process dict (the trace flags cache_backend=memory)
REDIS_URL=

# ---------- harness ----------
DEFAULT_LOCALE=en-US
